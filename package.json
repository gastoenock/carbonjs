{
  "name": "jscarbon",
  "version": "1.0.0",
  "description": " A simple Javascript Package as an extension of Javascript Date object.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": "./dist/carbon.global.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastoenock/carbonjs.git"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "watch": "tsup --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --experimental-vm-modules --test tests/*.test.js"
  },
  "keywords": [
    "Javascript carbon",
    "Carbon in javascript",
    "Date manipulation library in Javacript",
    "Javascript time"
  ],
  "author": "Gasto Enock",
  "license": "MIT",
  "devDependencies": {
    "rollup": "^4.24.4",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "browser": "./dist/index.js",
  "files": [
    "dist",
    "index.js",
    "src/index.js",
    "src/Carbon.js",
    "src/Helper.js"
  ],
  "sideEffects": false
}
